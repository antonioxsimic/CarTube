<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />

    <queries>
        <package android:name="app.revanced.android.youtube" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.google.android.projection.gearhead" />
    </queries>

    <application
        android:name=".CarTubeApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.CarTube">

        <!-- Android Auto Metadata -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <meta-data
            android:name="com.google.android.gms.car.notification.SmallIcon"
            android:resource="@drawable/ic_app_icon" />

        <meta-data
            android:name="androidx.car.app.TintableAttributionIcon"
            android:resource="@drawable/ic_app_icon" />

        <meta-data
            android:name="com.google.android.gms.car.application.theme"
            android:resource="@style/Theme.CarTube" />

        <!-- Phone Companion Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Share Receiver Activity (Handles "Share" from YouTube ReVanced) -->
        <activity
            android:name=".ShareReceiverActivity"
            android:theme="@style/Theme.CarTube.Transparent"
            android:exported="true"
            android:label="Play on Car">

            <!-- Handle text/plain links shared from YouTube / ReVanced -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Also handle opening YouTube links directly -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" android:host="youtu.be" />
                <data android:scheme="https" android:host="youtu.be" />
                <data android:scheme="http" android:host="*.youtube.com" />
                <data android:scheme="https" android:host="*.youtube.com" />
            </intent-filter>
        </activity>

        <!-- Media Browser Service for Android Auto Launcher Discovery -->
        <service
            android:name=".service.CarTubeMediaService"
            android:label="@string/car_app_name"
            android:icon="@drawable/ic_app_icon"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Android Auto Fullscreen Car Service -->
        <service
            android:name=".car.CarTubeCarService"
            android:label="@string/car_app_name"
            android:icon="@drawable/ic_app_icon"
            android:enabled="true"
            android:exported="true">
            <meta-data
                android:name="androidx.car.app.minCarApiLevel"
                android:value="1" />
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>

    </application>

</manifest>
