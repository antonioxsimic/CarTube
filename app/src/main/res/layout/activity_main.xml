<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_app_icon"
                android:contentDescription="YouTube Car Icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YouTube"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Android Auto Companion"
                    android:textColor="#FF0033"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- YouTube TV Code Pairing Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#161824"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="POVEŽI YOUTUBE REVANCED (TV KOD)"
                        android:textColor="#FF0033"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/tvLoungeConnectionBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#222538"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="⚪ Čekam vezu"
                        android:textColor="#787C96"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Big TV Code -->
                <TextView
                    android:id="@+id/tvTvPairingCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="--- --- --- ---"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/tvLoungeStatusDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Generiram kod..."
                    android:textColor="#4DEEEA"
                    android:textSize="12sp" />

                <!-- Buttons: Copy TV Code & Refresh -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCopyCode"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:backgroundTint="#FF0033"
                        android:text="📋 Kopiraj TV Kod"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="8dp" />

                    <Button
                        android:id="@+id/btnRefreshCode"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="#222538"
                        android:text="🔄 Novi kod"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <!-- Instructions step-by-step -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="3dp"
                    android:text="1. Otvorite YouTube ReVanced na mobitelu\n2. Postavke ➔ Gledajte na TV-u ➔ Povežite kodom za TV\n3. Unesite gornji kod i kliknite 'Poveži'\n4. Nakon toga kliknite Cast ikonu u ReVanced i birajte 'BMW CarTube'!"
                    android:textColor="#A0A5BA"
                    android:textSize="12sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Active Video Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#161824"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvStatusHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STATUS REPRODUKCIJE"
                    android:textColor="#8E92A8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvVideoTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Nema aktivnog videa"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvChannel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Podijelite video iz YouTube ReVanced aplikacije"
                    android:textColor="#787C96"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvPlaybackState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#222538"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Čekam reprodukciju na autu"
                    android:textColor="#4DEEEA"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Seekbar Row on Phone -->
                <LinearLayout
                    android:id="@+id/layoutSeekbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp">

                    <SeekBar
                        android:id="@+id/phoneSeekBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="1000"
                        android:progress="0"
                        android:progressTint="#FF0033"
                        android:thumbTint="#FF0033" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="2dp"
                        android:paddingHorizontal="12dp">

                        <TextView
                            android:id="@+id/tvCurrentTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="00:00"
                            android:textColor="#A0A5BA"
                            android:textSize="12sp"
                            android:fontFamily="monospace" />

                        <TextView
                            android:id="@+id/tvTotalDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00"
                            android:textColor="#A0A5BA"
                            android:textSize="12sp"
                            android:fontFamily="monospace" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Video Aspect Ratio Scale Mode Toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="FORMAT PRIKAZA (ZASLON AUTA)"
                        android:textColor="#8E92A8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <Button
                        android:id="@+id/btnScaleMode"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:backgroundTint="#222538"
                        android:text="📐 Fit"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="14dp"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <!-- Audio Sync (Bluetooth Delay Offset) Toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="AUDIO SYNC (BLUETOOTH ODGODA)"
                        android:textColor="#8E92A8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <Button
                        android:id="@+id/btnAudioSync"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:backgroundTint="#222538"
                        android:text="⏱ +2.0s"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="14dp"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <!-- Video Quality Toggle (1080p Full HD vs 720p HD) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="KVALITETA VIDEA (REZOLUCIJA)"
                        android:textColor="#8E92A8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <Button
                        android:id="@+id/btnQuality"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:backgroundTint="#222538"
                        android:text="🎬 1080p"
                        android:textColor="#4DEEEA"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="14dp"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Direct Link Input Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#161824"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RUČNO POKRETANJE LINKA"
                    android:textColor="#8E92A8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <EditText
                    android:id="@+id/etYoutubeUrl"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="#222538"
                    android:hint="Zalijepite YouTube link ovdje..."
                    android:textColorHint="#5A5E78"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="14dp"
                    android:textSize="14sp"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/btnSendToCar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#FF0033"
                    android:text="▶ Pošalji na Auto Zaslon"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:cornerRadius="10dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- How To Use / Tip Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#161824"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KAKO KORISTITI (IDEJA 1)"
                    android:textColor="#FF0033"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="1. Otvorite vaš YouTube ReVanced na mobitelu.\n2. Kliknite 'Share' (Podijeli) ispod bilo kojeg videa.\n3. U izborniku odaberite 'YouTube' (s ikonicom auta).\n4. Video se automatski počinje reproducirati preko cijelog zaslona na vašem autu!"
                    android:textColor="#D0D3E5"
                    android:textSize="13sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
